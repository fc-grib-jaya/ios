default_platform(:ios)

# ---- Ganti di sini saja kalau ada yang berubah ----
APP_ID    = "com.gribjaya.lembu"
SCHEME    = "CattleFarmz"
TARGET    = "CattleFarmz"
XCODEPROJ = "CattleFarmz.xcodeproj" # sesuaikan dengan nama file .xcodeproj yang sebenarnya
TEAM_ID   = "CWXJ4ZG5J4"
PROFILE   = -> { ENV["sigh_#{APP_ID}_appstore_profile-name"] } # lazy: dibaca setelah match jalan
# ---------------------------------------------------

platform :ios do
  before_all do
    if ENV["CI"]
      setup_ci
      sh("git config user.name 'CI Bot'")
      sh("git config user.email 'ci-bot@gribjaya.com'")
    end
  end

  desc "Auth to App Store Connect (pakai ASC_KEY_CONTENT base64 kalau ada, fallback ke file)"
  private_lane :asc_api_key do
    if ENV["ASC_KEY_CONTENT"]
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT"],
        is_key_content_base64: true,
        in_house: false
      )
    else
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_filepath: "asc_api_key.p8",
        in_house: false
      )
    end
  end

  private_lane :setup_signing do |options|
    match(
      type: "appstore",
      app_identifier: [APP_ID],
      api_key: options[:api_key]
    )
  end

  private_lane :apply_signing do
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE.call,
      targets: [TARGET]
    )
  end

  private_lane :build_and_upload do |options|
    build_app(
      scheme: SCHEME,
      clean: true,
      export_method: "app-store",
      output_directory: "./build",
      output_name: "#{SCHEME}.ipa",
      export_team_id: TEAM_ID,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          APP_ID => PROFILE.call
        }
      }
    )

    upload_to_testflight(
      api_key: options[:api_key],
      skip_waiting_for_build_processing: true
    )
  end

  # ---------- Upload dari lokal (tanpa .p8) ----------
  # Pakai: fastlane local_testflight build:123
  # Butuh env: FASTLANE_USER (Apple ID) dan
  #            FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD (app-specific password)
  desc "Build & upload ke TestFlight dari lokal pakai Apple ID"
  lane :local_testflight do |options|
    UI.user_error!("Wajib isi build number: fastlane local_testflight build:123") unless options[:build]

    match(type: "appstore", app_identifier: [APP_ID], readonly: true)
    apply_signing
    increment_build_number(build_number: options[:build], xcodeproj: XCODEPROJ)

    build_and_upload(api_key: asc_api_key)
  end

  # ---------- Untuk tim (lokal) ----------
  desc "Download development cert & profile (readonly, TIDAK butuh file .p8)"
  lane :sync_certs do
    match(
      type: "development",
      app_identifier: [APP_ID],
      readonly: true
    )
  end

  # ---------- Admin saja ----------
  desc "Buat/perbarui development cert & profile (butuh ASC API key)"
  lane :renew_certs do
    match(
      type: "development",
      app_identifier: [APP_ID],
      api_key: asc_api_key,
      force_for_new_devices: true
    )
  end

  # ---------- CI ----------
  desc "Push to dev branch -> patch bump + TestFlight"
  lane :dev_patch_release do
    api_key = asc_api_key
    setup_signing(api_key: api_key)
    apply_signing

    current = get_version_number(xcodeproj: XCODEPROJ, target: TARGET)
    major, minor, patch = current.split(".").map(&:to_i)
    new_version = "#{major}.#{minor}.#{patch + 1}"
    increment_version_number(version_number: new_version, xcodeproj: XCODEPROJ)
    increment_build_number(build_number: ENV["GITHUB_RUN_NUMBER"], xcodeproj: XCODEPROJ)

    build_and_upload(api_key: api_key)

    # GitHub pre-release
    ipa_path = File.join(Dir.pwd, "build", "#{SCHEME}.ipa")
    tag_name = "v#{new_version}-beta"

    set_github_release(
      repository_name: ENV["GITHUB_REPOSITORY"],
      api_token: ENV["GITHUB_TOKEN"],
      tag_name: tag_name,
      name: tag_name,
      description: "Prerelease build #{tag_name}\n\nIPA: `#{SCHEME}.ipa` attached below.",
      commitish: "dev",
      is_prerelease: true,
      upload_assets: [ipa_path]
    )

    git_commit(
      path: ["*.xcodeproj/project.pbxproj"],
      message: "chore(ci): bump version to #{new_version} (#{ENV['GITHUB_RUN_NUMBER']}) [skip ci]"
    )
    push_to_git_remote(remote_branch: "dev")
  end

  desc "Push to dev without bump patch version"
  lane :dev_build_release do
    api_key = asc_api_key
    setup_signing(api_key: api_key)
    apply_signing

    increment_build_number(build_number: ENV["GITHUB_RUN_NUMBER"], xcodeproj: XCODEPROJ)

    build_and_upload(api_key: api_key)

    git_commit(
      path: ["*.xcodeproj/project.pbxproj"],
      message: "chore(ci): bump build version to (#{ENV['GITHUB_RUN_NUMBER']}) [skip ci]"
    )
    push_to_git_remote(remote_branch: "dev")
  end

  desc "GitHub Release published in main -> set version from tag + TestFlight"
  lane :release do
    api_key = asc_api_key
    setup_signing(api_key: api_key)
    apply_signing

    version = ENV["RELEASE_TAG"].sub(/^v/, "")
    increment_version_number(version_number: version, xcodeproj: XCODEPROJ)
    increment_build_number(build_number: ENV["GITHUB_RUN_NUMBER"], xcodeproj: XCODEPROJ)

    build_and_upload(api_key: api_key)

    git_commit(
      path: ["*.xcodeproj/project.pbxproj"],
      message: "chore(release): version #{version} (#{ENV['GITHUB_RUN_NUMBER']}) [skip ci]"
    )
    push_to_git_remote(remote_branch: "main")
  end


 desc "Admin only: buat/perbarui appstore profile lewat API key (tanpa login Apple ID)"
  lane :renew_appstore_profile do
    match(
      type: "appstore",
      app_identifier: [APP_ID],
      api_key: asc_api_key
    )
  end
end

